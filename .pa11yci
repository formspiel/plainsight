{
  "defaults": {
    "standard": "WCAG2AA",
    "includeWarnings": false,
    "includeNotices": false,
    "timeout": 30000,
    "wait": 500,
    "chromeLaunchConfig": {
      "args": ["--no-sandbox"]
    }
